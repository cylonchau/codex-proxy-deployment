# 复制为 .env(或运行 ./ops.sh init 自动生成)。.env 不要进 git。
# 必填(init 会随机生成):
WEBUI_SECRET_KEY=
CODEX_API_KEY=
POSTGRES_PASSWORD=

# 可选:
# WEBUI_NAME=Codex Web
# WEBUI_BIND=127.0.0.1     # 放到反向代理后面时保持 127.0.0.1;直接对外才改 0.0.0.0
# WEBUI_PORT=3000
# API_BIND=127.0.0.1       # 不需要从宿主机直接调 API 时,可在 compose 里删掉这个端口映射
# API_PORT=8100
# CODEX_SANDBOX=read-only  # 不要改成 danger-full-access:容器里有登录令牌
# CODEX_MODELS=            # 额外模型名,逗号分隔(通常不需要,模型表自动来自 Codex)
# SESSION_TTL_DAYS=30      # 会话记录和聊天工作目录的保留天数
# MAX_CONCURRENCY=4        # 同时运行的 codex 进程数,超出排队
