# 复制为 .env 后填写;或直接运行 ./ops.sh up,它会自动生成带随机密钥的 .env(权限 600)。
# 自动生成的是最简配置:内置 Postgres + HTTP 直连 127.0.0.1:3000。生产环境请按下面两段改成外部库、HTTPS。
# .env 里有密钥,不要进 git,不要拷到别的环境。

# ---- 必填 ----
# Open WebUI 的会话签名密钥(openssl rand -hex 32)。换了会让所有人重新登录。
WEBUI_SECRET_KEY=
# Open WebUI 访问 codex-api 的密钥(sk-codex- 加 openssl rand -hex 24)。
CODEX_API_KEY=

# ---- 数据库:二选一 ----
# 方式一(默认):内置 Postgres,自动启动。DATABASE_URL 保持为空,填下面的密码。
# 密码用 openssl rand -hex 24 生成,只用字母数字。
POSTGRES_PASSWORD=
# 方式二:连外部 Postgres。填 DATABASE_URL 即可,此时不会启动内置库,POSTGRES_PASSWORD 不再需要。
# 先在外部库里按 postgres/init.sql 建好库和账号。账号密码里的特殊字符要做 URL 编码(@ 写成 %40,$ 写成 %24)。
# 需要 TLS 就在末尾加 ?sslmode=require
# DATABASE_URL=postgresql://openwebui:密码@db.example.com:5432/openwebui?sslmode=require
DATABASE_URL=

# ---- 访问方式:二选一 ----
# 方式一(默认):HTTP 直连。Open WebUI 监听 WEBUI_BIND:WEBUI_PORT,默认只在本机 127.0.0.1:3000。
#   想直接用 80 端口(明文 HTTP)就改成  WEBUI_BIND=0.0.0.0  WEBUI_PORT=80。
# WEBUI_BIND=127.0.0.1
# WEBUI_PORT=3000
# 方式二:HTTPS。设为 true 后,nginx 监听 80(自动跳转)和 443(用你买的证书),Open WebUI 不再单独占端口。
#   证书放进 certs/ 目录:fullchain.pem(服务器证书 + 中间证书链)和 privkey.pem(私钥),做法见 README。
HTTPS=false
# HTTP_PORT=80
# HTTPS_PORT=443          # 改了以后,80 端口的自动跳转仍指向 443,请直接访问 https://域名:端口
# PUBLIC_BIND=0.0.0.0     # 80/443 监听的地址
# CERT_DIR=./certs        # 证书目录,可以指向别处(比如 /etc/ssl/openwebui)

# ---- 其他(可选,取消注释才生效)----
# WEBUI_NAME=Codex Web
# 不需要从宿主机直接调 API 时,可在 compose.yaml 里删掉 codex-api 的端口映射。
# API_BIND=127.0.0.1
# API_PORT=8100
# 不要改成 danger-full-access:容器里有登录令牌。
# CODEX_SANDBOX=read-only
# 额外模型名,逗号分隔(通常不需要,模型表自动来自 Codex)。
# CODEX_MODELS=
# 会话记录和聊天工作目录的保留天数。
# SESSION_TTL_DAYS=30
# 同时运行的 codex 进程数,超出排队。
# MAX_CONCURRENCY=4
